<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#0B0E0B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lf_entrenamiento"
            android:textColor="#C4FF19" android:textSize="16sp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tvNombreRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_libre"
            android:textColor="#F5F5F0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            />
        <EditText
            android:id="@+id/etEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ent_ejercicio"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:maxLines="1"
            android:maxLength="80"
            android:textColor="#F5F5F0"
            android:textColorHint="#B8BDB2"
            android:backgroundTint="#B8BDB2"
            android:imeOptions="actionNext"
            />
        <Button
            android:id="@+id/btnElegir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_elegir"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#C4FF19"
            android:backgroundTint="#252D1C"
            />
        <Button
            android:id="@+id/btnNombrePropio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_guardar_nombre"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#C4FF19"
            android:backgroundTint="#252D1C" />
        <EditText
            android:id="@+id/etPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ent_peso"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:maxLines="1"
            android:maxLength="10"
            android:textColor="#F5F5F0"
            android:textColorHint="#B8BDB2"
            android:backgroundTint="#B8BDB2"
            />
        <EditText
            android:id="@+id/etSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ent_series"
            android:inputType="number"
            android:minHeight="48dp"
            android:maxLines="1"
            android:maxLength="4"
            android:textColor="#F5F5F0"
            android:textColorHint="#B8BDB2"
            android:backgroundTint="#B8BDB2"
            />
        <EditText
            android:id="@+id/etRepeticiones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ent_reps"
            android:inputType="number"
            android:minHeight="48dp"
            android:maxLines="1"
            android:maxLength="4"
            android:textColor="#F5F5F0"
            android:textColorHint="#B8BDB2"
            android:backgroundTint="#B8BDB2"
            />
        <Button
            android:id="@+id/btnAgregarFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_agregar"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#0B0E0B"
            android:backgroundTint="#C4FF19"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_resumen"
            android:textColor="#F5F5F0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            />
        <TextView
            android:id="@+id/tvFilas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_sin_filas"
            android:textColor="#F5F5F0"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            />
        <Button
            android:id="@+id/btnQuitar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_quitar"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#C4FF19"
            android:backgroundTint="#252D1C"
            />
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F5F0"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnGuardarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_guardar_sesion"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#0B0E0B"
            android:backgroundTint="#C4FF19" />
        <Button
            android:id="@+id/btnVolverRutinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ent_volver"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"
            android:textColor="#C4FF19"
            android:backgroundTint="#252D1C"
            />
    </LinearLayout>
</ScrollView>