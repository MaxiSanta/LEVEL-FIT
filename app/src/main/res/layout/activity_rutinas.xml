<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:background="#0B0E0B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#C4FF19" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvTituloRutinas" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_pred" android:textColor="#F5F5F0" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="12dp" />
        <LinearLayout android:id="@+id/seccionPredeterminadas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <Button android:id="@+id/btnCuerpoCompleto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_tit_cuerpo" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#C4FF19" android:backgroundTint="#252D1C" />
            <TextView android:id="@+id/tvDetalleCuerpoCompleto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F5F0" android:textSize="16sp" android:visibility="gone" android:padding="12dp" android:background="#191D17" />
            <Button android:id="@+id/btnTrenSuperior" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_tit_superior" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#C4FF19" android:backgroundTint="#252D1C" />
            <TextView android:id="@+id/tvDetalleSuperior" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F5F0" android:textSize="16sp" android:visibility="gone" android:padding="12dp" android:background="#191D17" />
            <Button android:id="@+id/btnTrenInferior" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_tit_inferior" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#C4FF19" android:backgroundTint="#252D1C" />
            <TextView android:id="@+id/tvDetalleInferior" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F5F0" android:textSize="16sp" android:visibility="gone" android:padding="12dp" android:background="#191D17" />
            <Button android:id="@+id/btnCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_tit_core" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#C4FF19" android:backgroundTint="#252D1C" />
            <TextView android:id="@+id/tvDetalleCore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F5F0" android:textSize="16sp" android:visibility="gone" android:padding="12dp" android:background="#191D17" />
        </LinearLayout>
        <TextView android:id="@+id/tvCatalogoPropio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F5F5F0" android:textSize="16sp" android:visibility="gone" android:layout_marginTop="16dp" />
        <Button android:id="@+id/btnComenzarEntrenamiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_comenzar" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#0B0E0B" android:backgroundTint="#C4FF19" android:enabled="false" />
        <Button android:id="@+id/btnVolverMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ent_volver" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textColor="#C4FF19" android:backgroundTint="#252D1C" />
    </LinearLayout>
</ScrollView>